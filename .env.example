# Copie para .env (ou configure no IntelliJ / Render). Nunca commite os valores reais.
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USER=rmXXXXXX
DB_PASSWORD=sua_senha

# Base dos Dados (BigQuery): conteúdo do JSON da conta de serviço do Google Cloud, em uma linha
BASEDOSDADOS_CREDENTIALS=
# Opcional: projeto que paga a consulta (vazio = project_id do JSON)
BASEDOSDADOS_BILLING_PROJECT=
BASEDOSDADOS_UF=SP
BASEDOSDADOS_SYNC_ON_STARTUP=true
BASEDOSDADOS_MAX_AGE_DAYS=7
